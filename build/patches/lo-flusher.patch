@@ -46,44 +48,72 @@ namespace drawinglayer::primitive2d
     do not have access to vcl-level API here (like SolarMutexReleaser and vcl::Timer).
 */
 
-static BufferedDecompositionFlusher* getInstance()
-{
-    static std::unique_ptr<BufferedDecompositionFlusher> gaTimer(new BufferedDecompositionFlusher);
-    return gaTimer.get();
-}
+// The flusher thread is made on demand and can be stopped for LibreOfficeKit's joinThreads
+// (a process image is saved with no background thread running) and made again by the next
+// update(); shutdown() stops it for good.
+static std::mutex gaInstanceMutex;
+static std::unique_ptr<BufferedDecompositionFlusher> gaInstance;
+static bool gbFinal = false;
 
-// static
-void BufferedDecompositionFlusher::shutdown()
+// stop and destroy the running flusher outside gaInstanceMutex: while it stops, the thread
+// may release primitives, whose remove() takes gaInstanceMutex
+static void stopFlusher(bool bFinal)
 {
-    BufferedDecompositionFlusher* pFlusher = getInstance();
+    std::unique_ptr<BufferedDecompositionFlusher> pFlusher;
+    {
+        std::unique_lock l(gaInstanceMutex);
+        if (bFinal)
+            gbFinal = true;
+        pFlusher = std::move(gaInstance);
+    }
+    if (!pFlusher)
+        return;
     pFlusher->onTeardown();
     // We have to wait for the thread to exit, otherwise we might end up with the background thread
     // trying to process stuff while it has things ripped out underneath it.
     pFlusher->join();
 }
 
+// static
+void BufferedDecompositionFlusher::shutdown() { stopFlusher(true); }
+
+// static
+void BufferedDecompositionFlusher::joinThread() { stopFlusher(false); }
+
 // static
 void BufferedDecompositionFlusher::update(const BufferedDecompositionPrimitive2D* p)
 {
-    getInstance()->updateImpl(p);
+    std::unique_lock l(gaInstanceMutex);
+    if (!gaInstance && !gbFinal)
+        gaInstance.reset(new BufferedDecompositionFlusher);
+    if (gaInstance)
+        gaInstance->updateImpl(p);
 }
 
 // static
 void BufferedDecompositionFlusher::update(const BufferedDecompositionGroupPrimitive2D* p)
 {
-    getInstance()->updateImpl(p);
+    std::unique_lock l(gaInstanceMutex);
+    if (!gaInstance && !gbFinal)
+        gaInstance.reset(new BufferedDecompositionFlusher);
+    if (gaInstance)
+        gaInstance->updateImpl(p);
 }
 
 // static
 void BufferedDecompositionFlusher::remove(const BufferedDecompositionPrimitive2D* p)
 {
-    getInstance()->removeImpl(p);
+    std::unique_lock l(gaInstanceMutex);
+    if (gaInstance)
+        gaInstance->removeImpl(p);
 }
 
 // static
 void BufferedDecompositionFlusher::remove(const BufferedDecompositionGroupPrimitive2D* p)
 {
-    getInstance()->removeImpl(p);
+    std::unique_lock l(gaInstanceMutex);
+    if (gaInstance)
+        gaInstance->removeImpl(p);
 }
 
 BufferedDecompositionFlusher::BufferedDecompositionFlusher() { create(); }
